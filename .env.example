# Warshatak — Meta Llama API + Context Engine
# Copy this template into private .env. NEVER commit or share API keys.
PORT=3000

# Main chat — Meta Llama 3.3 70B Instruct via OpenRouter
CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
CHAT_API_KEY=
CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
CHAT_MAX_TOKENS=450

# Images and sampled video frames — Meta Llama 4 Scout via SAME API key
VISION_MODEL=meta-llama/llama-4-scout

# Audio processing — local CLAP/Whisper or optional Gemini API
# Set AUDIO_PROVIDER=gemini to use Google for audio/video audio.
# Keep your existing CHAT_* and VISION_MODEL settings. No key reaches the browser.
AUDIO_PROVIDER=local
GEMINI_API_KEY=
# Example from Google's official audio cookbook; verify model access/limits for your project.
GEMINI_AUDIO_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MAX_SECONDS=30
FFMPEG_PATH=ffmpeg
ENABLE_AUDIO_CLAP=0
AUDIO_PYTHON=python
CLAP_MODEL=laion/clap-htsat-unfused
ENABLE_SPEECH_TRANSCRIPTION=0
WHISPER_MODEL=base
