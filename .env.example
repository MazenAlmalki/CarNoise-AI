# Warshatak multimodal V5 (November 2026). Keep .env private!
PORT=3000

# Text chat. Qwen3.5:2b is a small current multimodal model; choose one.
CHAT_MODEL=qwen3.5:2b
# Faster local Qwen responses: limits generation and context.
CHAT_MAX_TOKENS=320
CHAT_CONTEXT=4096
# 0 = faster AI-generated response; 1 = model reasoning enabled (slower on CPU)
CHAT_THINK=0

# Existing legacy analysis route (optional fallback).
LLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions
LLAMA_API_KEY=
LLAMA_MODEL=qwen3.5:2b

# Visual model for image uploads and sampled video frames.
OLLAMA_HOST=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:2b

# Basic audio waveform analysis works automatically when FFmpeg is on PATH.
# Optional CLAP sound similarity requires heavy Python dependencies (off on 8GB RAM).
# Video frame extraction also requires FFmpeg.
ENABLE_AUDIO_CLAP=0
AUDIO_PYTHON=python
FFMPEG_PATH=ffmpeg
CLAP_MODEL=laion/clap-htsat-unfused
