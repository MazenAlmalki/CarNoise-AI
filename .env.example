# Warshatak — Hosted Meta Llama chat API (November 2026)
# Copy this file to .env. Never commit .env or your API key.
PORT=3000

# Main text chat and legacy analysis: OpenRouter / Meta Llama 3.3 70B
CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
CHAT_API_KEY=
CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
CHAT_MAX_TOKENS=450

# Separate image/video frame analysis still runs locally using Ollama vision.
# This is NOT the text chat model; change it separately if desired.
OLLAMA_HOST=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:2b

# Basic audio waveform analysis: needs FFmpeg
# Optional sound similarity (CLAP) requires Python dependencies.
ENABLE_AUDIO_CLAP=0
AUDIO_PYTHON=python
FFMPEG_PATH=ffmpeg
CLAP_MODEL=laion/clap-htsat-unfused

# Optional speech-to-text (Whisper/faster-whisper, local)
ENABLE_SPEECH_TRANSCRIPTION=0
WHISPER_MODEL=base
